{
  "name": "@pankaj28843/web-components",
  "version": "0.1.0",
  "description": "A context-neutral unified diff review web component with safe syntax highlighting.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pankaj28843/web-components.git"
  },
  "homepage": "https://github.com/pankaj28843/web-components",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/share.js",
      "default": "./dist/share.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006",
    "build:storybook": "storybook build --output-dir storybook-static",
    "check:storybook": "node scripts/check-storybook-build.mjs",
    "build": "pnpm typecheck && vite build && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/web-components-vite": "^10.5.8",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "storybook": "^10.5.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
